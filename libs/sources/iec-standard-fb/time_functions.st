(* IEC 61131-3 Ed. 3 Table 36: concatenating and splitting dates and times.
   Inputs take any integer (as LINT); YEAR and MILLISECOND come out as UINT,
   the other parts as USINT. SPLIT_* returns TRUE. Dates use the proleptic
   Gregorian calendar. *)

FUNCTION CONCAT_DATE : DATE
  VAR_INPUT YEAR, MONTH, DAY : LINT; END_VAR
  VAR y, era, yoe, mp, doy, doe : LINT; END_VAR
  y := YEAR;
  IF MONTH <= 2 THEN y := y - 1; END_IF;
  IF y >= 0 THEN era := y / 400; ELSE era := (y - 399) / 400; END_IF;
  yoe := y - era * 400;
  IF MONTH > 2 THEN mp := MONTH - 3; ELSE mp := MONTH + 9; END_IF;
  doy := (153 * mp + 2) / 5 + DAY - 1;
  doe := yoe * 365 + yoe / 4 - yoe / 100 + doy;
  CONCAT_DATE := LINT_TO_DATE((era * 146097 + doe - 719468) * 86400);
END_FUNCTION

FUNCTION CONCAT_TOD : TOD
  VAR_INPUT HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR
  CONCAT_TOD := LINT_TO_TOD(((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND);
END_FUNCTION

FUNCTION CONCAT_LTOD : LTOD
  VAR_INPUT HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR
  CONCAT_LTOD := LINT_TO_LTOD((((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000);
END_FUNCTION

FUNCTION CONCAT_LDT : LDT
  VAR_INPUT YEAR, MONTH, DAY, HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR
  CONCAT_LDT := LINT_TO_LDT(LDATE_TO_LINT(CONCAT_DATE(YEAR, MONTH, DAY))
    + (((HOUR * 60 + MINUTE) * 60 + SECOND) * 1000 + MILLISECOND) * 1000000);
END_FUNCTION

FUNCTION CONCAT_DT : DT
  VAR_INPUT YEAR, MONTH, DAY, HOUR, MINUTE, SECOND, MILLISECOND : LINT; END_VAR
  CONCAT_DT := LDT_TO_DT(CONCAT_LDT(YEAR, MONTH, DAY, HOUR, MINUTE, SECOND, MILLISECOND));
END_FUNCTION

FUNCTION CONCAT_DATE_LTOD : LDT
  VAR_INPUT DATE_IN : DATE; TOD_IN : LTOD; END_VAR
  CONCAT_DATE_LTOD := LINT_TO_LDT(LDATE_TO_LINT(DATE_IN) + LTOD_TO_LINT(TOD_IN));
END_FUNCTION

FUNCTION SPLIT_DATE : BOOL
  VAR_INPUT IN : DATE; END_VAR
  VAR_OUTPUT YEAR : UINT; MONTH, DAY : USINT; END_VAR
  VAR z, era, doe, yoe, doy, mp, y, m : LINT; END_VAR
  z := DATE_TO_LINT(IN) / 86400 + 719468;
  IF z >= 0 THEN era := z / 146097; ELSE era := (z - 146096) / 146097; END_IF;
  doe := z - era * 146097;
  yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  doy := doe - (365 * yoe + yoe / 4 - yoe / 100);
  mp := (5 * doy + 2) / 153;
  DAY := LINT_TO_USINT(doy - (153 * mp + 2) / 5 + 1);
  IF mp < 10 THEN m := mp + 3; ELSE m := mp - 9; END_IF;
  y := yoe + era * 400;
  IF m <= 2 THEN y := y + 1; END_IF;
  MONTH := LINT_TO_USINT(m);
  YEAR := LINT_TO_UINT(y);
  SPLIT_DATE := TRUE;
END_FUNCTION

FUNCTION SPLIT_TOD : BOOL
  VAR_INPUT IN : TOD; END_VAR
  VAR_OUTPUT HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR
  VAR ms : LINT; END_VAR
  ms := TOD_TO_LINT(IN);
  HOUR := LINT_TO_USINT(ms / 3600000);
  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);
  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);
  MILLISECOND := LINT_TO_UINT(ms MOD 1000);
  SPLIT_TOD := TRUE;
END_FUNCTION

FUNCTION SPLIT_LTOD : BOOL
  VAR_INPUT IN : LTOD; END_VAR
  VAR_OUTPUT HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR
  VAR ms : LINT; END_VAR
  ms := LTOD_TO_LINT(IN) / 1000000;
  HOUR := LINT_TO_USINT(ms / 3600000);
  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);
  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);
  MILLISECOND := LINT_TO_UINT(ms MOD 1000);
  SPLIT_LTOD := TRUE;
END_FUNCTION

FUNCTION SPLIT_LDT : BOOL
  VAR_INPUT IN : LDT; END_VAR
  VAR_OUTPUT YEAR : UINT; MONTH, DAY, HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR
  VAR ns, days, ms : LINT; END_VAR
  ns := LDT_TO_LINT(IN);
  days := ns / 86400000000000;
  IF ns < 0 AND days * 86400000000000 <> ns THEN days := days - 1; END_IF;
  SPLIT_DATE(IN := LINT_TO_DATE(days * 86400), YEAR => YEAR, MONTH => MONTH, DAY => DAY);
  ms := (ns - days * 86400000000000) / 1000000;
  HOUR := LINT_TO_USINT(ms / 3600000);
  MINUTE := LINT_TO_USINT(ms / 60000 MOD 60);
  SECOND := LINT_TO_USINT(ms / 1000 MOD 60);
  MILLISECOND := LINT_TO_UINT(ms MOD 1000);
  SPLIT_LDT := TRUE;
END_FUNCTION

FUNCTION SPLIT_DT : BOOL
  VAR_INPUT IN : DT; END_VAR
  VAR_OUTPUT YEAR : UINT; MONTH, DAY, HOUR, MINUTE, SECOND : USINT; MILLISECOND : UINT; END_VAR
  SPLIT_LDT(IN := DT_TO_LDT(IN), YEAR => YEAR, MONTH => MONTH, DAY => DAY,
    HOUR => HOUR, MINUTE => MINUTE, SECOND => SECOND, MILLISECOND => MILLISECOND);
  SPLIT_DT := TRUE;
END_FUNCTION

FUNCTION DAY_OF_WEEK : INT
  VAR_INPUT IN : DATE; END_VAR
  VAR days : LINT; END_VAR
  days := DATE_TO_LINT(IN) / 86400;
  DAY_OF_WEEK := LINT_TO_INT(((days MOD 7) + 7 + 4) MOD 7);
END_FUNCTION
